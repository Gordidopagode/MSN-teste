# Runtime
MSN_HOST=0.0.0.0
MSN_PORT=8765
MSN_DATA_DIR=./data
# No launcher local, deixe vazio. Para frontend servido separadamente, use
# origens exatas http:// ou https:// separadas por vírgula.
MSN_ALLOWED_ORIGINS=

# Gmail SMTP — preencher somente no gerenciador de secrets do provedor.
# Nunca comitar um arquivo .env real.
MSN_SMTP_HOST=smtp.gmail.com
MSN_SMTP_PORT=587
MSN_SMTP_USERNAME=supportemsnoficial@gmail.com
MSN_SMTP_PASSWORD=
MSN_SMTP_FROM=supportemsnoficial@gmail.com

# Recovery policy
MSN_RESET_TOKEN_TTL_MINUTES=15
MSN_RESET_MAX_ATTEMPTS=5
MSN_RESET_REQUESTS_PER_HOUR=5
