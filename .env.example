# Runtime
MSN_HOST=0.0.0.0
MSN_PORT=8765
MSN_DATA_DIR=./data
# No launcher local, deixe vazio. Para frontend servido separadamente, use
# origens exatas http:// ou https:// separadas por vírgula.
MSN_ALLOWED_ORIGINS=

# O reset atual usa o código local mostrado uma única vez no cadastro.
# SMTP/Gmail não é necessário. Estes nomes são mantidos somente para
# compatibilidade futura e não devem ser preenchidos para o fluxo atual.
# MSN_SMTP_HOST=
# MSN_SMTP_PORT=587
# MSN_SMTP_USERNAME=
# MSN_SMTP_PASSWORD=
# MSN_SMTP_FROM=

# Limite de tentativas do código local.
MSN_RESET_MAX_ATTEMPTS=5
